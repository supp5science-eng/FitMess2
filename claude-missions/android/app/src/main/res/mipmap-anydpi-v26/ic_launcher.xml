<?xml version="1.0" encoding="utf-8"?>
<!--
  Two deliberate departures from what `@capacitor/assets` writes, so re-running
  `scripts/gen-store-assets.cjs` means restoring this file afterwards:

  - The background is a flat colour, not the inset PNG the tool generates. An
    adaptive icon's background layer is meant to cover the whole 108dp canvas;
    an inset drawable leaves transparent corners the moment a launcher applies
    its zoom or parallax effect.
  - The foreground keeps the 16.7% inset. Only the middle 72dp of the 108dp
    canvas is guaranteed visible, so without the inset the pear is drawn at 93%
    of the visible circle and the stem meets the mask edge.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:drawable="@mipmap/ic_launcher_foreground" android:inset="16.7%" />
    </foreground>
</adaptive-icon>
