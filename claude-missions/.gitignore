# --- CREDENTIALS ---
# Never commit any .env variant. .env.example is the only env file in git.
.env
.env.local
.env.*.local
.env.development
.env.production

# --- VERIFICATION SCRIPTS ---
# Connection verification scripts are temporary; they're deleted on PASS.
# Keep them out of git even before deletion.
missions/*/connections/verify/

# --- HOOK & TEST OUTPUT ---
/tmp/missions-test-output.log
/tmp/missions-verify-body

# --- OS NOISE ---
.DS_Store
Thumbs.db

# --- EDITOR NOISE ---
.vscode/
.idea/
*.swp
*.swo

# --- BUILD / DEPS (project will add its own) ---
node_modules/
dist/
build/
.next/
__pycache__/
*.pyc

# --- NEXT.JS APP (added F001 scaffold) ---
/out/
/coverage
.vercel
*.tsbuildinfo
next-env.d.ts
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# NOTE: do NOT ignore `missions/` in general — mission state IS the project's
# documentation. Only the verify/ subdirectory is excluded.

# --- STORE ASSETS ---
# Raw captures stay out: they are the unframed intermediate step, nothing
# uploads them anywhere, and `scripts/store/capture-screens.cjs` remakes them
# from the live app in one run.
/store/raw/
#
# The framed listing images under `store/screenshots/` USED to be ignored for
# the same reason — regenerable, ~1 MB each. That was wrong. Regenerating them
# needs the app running under Playwright with a seeded demo account, so on any
# machine without the project they do not exist at all, and on 13.08.2026 that
# stopped the Play listing from being finished from a laptop. 20 MB once is
# cheaper than a blocked store submission.

# Local avatar-klon test photos + output. Never committed: every face on them
# belongs to a real person.
klon-proba/
