<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>FitMess</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The URL scheme Google's Sign-In SDK hands control back on.

	     It is the iOS OAuth client id with its parts reversed, and it is not
	     optional decoration: without this key the SDK refuses to start at all,
	     so "Nastavi sa Google" fails at the tap with nothing in any log. The
	     value must stay in lockstep with `GOOGLE_IOS_CLIENT_ID` in
	     `src/lib/auth/google-clients.ts` — same client, written two ways — and
	     with the same id in Supabase's *Authorized Client IDs*. See
	     `docs/prijava-sa-google.md`.

	     Nothing else in the app registers a URL scheme; this array exists solely
	     for the sign-in round trip, which is why it carries no other entry. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1004641833797-je2j6t0fi7darlto4pv9aaduohvpd9j7</string>
			</array>
		</dict>
	</array>
	<!-- Export compliance, answered here instead of in a form. Every build
	     uploaded to TestFlight otherwise arrives flagged "Missing Compliance"
	     and cannot be handed to a single tester until someone clicks through
	     the encryption questionnaire — for each new build, forever.

	     `false` is the truthful answer: the app's only cryptography is HTTPS to
	     fitmess.app and the platform's own keychain, which is exactly the
	     exemption Apple describes. It does not ship an encryption algorithm of
	     its own. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Camera and microphone: without these keys iOS does not even SHOW the
	     permission dialog, it just denies silently — the flows below would look
	     broken with nothing to explain them. The web code is untouched:
	     `getUserMedia` works in WKWebView since iOS 14.3.

	     The microphone one is the easy one to forget. Prizma and Gric record
	     the user describing what they ate, so a build with only the camera key
	     ships a feature that can never start. -->
	<key>NSCameraUsageDescription</key>
	<string>Kamera je potrebna da slikaš obrok ili deklaraciju proizvoda, pa da FitMess proceni kalorije umesto tebe.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Mikrofon je potreban da izgovoriš šta si pojeo umesto da kucaš — snimak se koristi samo za procenu tog unosa.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Portrait only. FitMess is laid out for a phone held upright — every
	     screen, the floating nav, the camera flows — and there is no landscape
	     design to fall back on. Offering a rotation that produces a broken
	     layout is worse than not offering it. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
