<?xml version="1.0" encoding="utf-8"?>
<!-- The app's ground colour. Same value as the `ground` token in globals.css
     (written without its leading double hyphen: XML forbids that sequence
     inside a comment), the manifest theme_color and the native splash, so
     nothing flashes at launch. -->
<resources>
    <color name="ic_launcher_background">#0a0c0b</color>
</resources>
