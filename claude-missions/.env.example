# Adaptive Cut Companion -- environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this file (`.env.example`) is the only env file committed to git and
# must never contain a real secret. See missions/20260717-183157/tech-decisions.md
# and missions/20260717-183157/connections/mcp-registry.md for the source of
# truth on which service each variable belongs to.

# ---- Supabase ----
# Project dashboard -> Project Settings -> API. New key format (2026):
# sb_publishable_... is safe to expose to the browser; sb_secret_... is
# server-only and must never be sent to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ---- Gemini (agent + vision) ----
# Google AI Studio API key. Server-side only (never NEXT_PUBLIC_).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Jaci Pro model SAMO za procenu obroka sa slike (prepoznaje sitne sastojke
# koje Flash promasi). Opciono -- ako je prazno, koristi se ugradjeni default.
GEMINI_MEAL_MODEL=gemini-3.1-pro-preview

# ---- Google OAuth ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Kept for reference; the provider is enabled directly in Supabase Auth.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ---- Google Maps (Trčanje live map) ----
# Google Cloud Console -> APIs & Services -> Library. Enable, on this one key:
#   - "Maps JavaScript API"  (the map itself)
#   - "Geocoding API"        (search a destination / cilj)
#   - "Directions API"       (draw the walked route to the cilj)
# Then Credentials -> API key. This key is embedded in the browser bundle
# (NEXT_PUBLIC_), so it is NOT a secret -- lock it down instead by HTTP-referrer
# restriction (localhost + your domain) and by restricting it to those APIs.
# Used by the /trcanje recording + run-detail map. The map's clean, label-free
# running look is styled entirely in code (src/components/run/run-map.tsx), so
# it no longer depends on any Cloud-console map styling.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key_here
# Vector Map ID (Map Management -> Create Map ID -> JavaScript / Vector).
# OPTIONAL, but it's what unlocks 3D buildings + tilt + two-finger rotate on the
# run recorder. WITHOUT it the map falls back to the in-code clean style
# (clutter-free but flat). WITH it, the look comes from the Map ID's associated
# Cloud style — so attach a dark style with "Points of interest / Business"
# turned OFF, or the cafés/shops come back. Main-street + place labels stay on.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your_google_maps_vector_map_id_here

# ---- PostHog (EU, analytics) ----
# PostHog project settings -> Project API Key. EU cloud host.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Sentry (error monitoring, EU) ----
# Sentry project settings -> Client Keys (DSN). Same DSN client + server.
SENTRY_DSN=https://your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here
SENTRY_ORG=your_sentry_org_slug_here
SENTRY_PROJECT=your_sentry_project_slug_here

# ---- Web Push (VAPID) ----
# Generate a VAPID key pair (e.g. `npx web-push generate-vapid-keys`).
# The public key is safe to expose; the private key is server-only.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com

# Supabase Management API (worker DB ops)
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
SUPABASE_PROJECT_REF=your_project_ref

# ---- SEO / Google Search Console ----
# Site-verification token from Search Console -> "HTML tag" method (the value
# inside content="..."). Set it here (and in the Vercel env) to emit the
# <meta name="google-site-verification"> tag. Leave unset once DNS/other
# verification is in place; the tag is optional and only used for verification.
GOOGLE_SITE_VERIFICATION=your_search_console_html_tag_token
