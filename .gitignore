# --- CREDENTIALS (never commit) ---
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
*secret*
*credential*

# Signing material for the stores. The App Store Connect API key (.p8) is shown
# exactly once by Apple and cannot be re-downloaded, so it tends to get parked
# next to the project "for a minute" — and the repository is public.
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks

# --- LOCAL CLAUDE CODE SETTINGS (machine-specific) ---
.claude/settings.local.json

# --- MISSION VERIFICATION SCRIPTS (temporary, may hold creds) ---
missions/*/connections/verify/

# --- HOOK & TEST OUTPUT ---
/tmp/missions-test-output.log
/tmp/missions-verify-body

# --- OS NOISE ---
.DS_Store
Thumbs.db

# --- EDITOR NOISE ---
.vscode/
.idea/
*.swp
*.swo

# --- BUILD / DEPS ---
node_modules/
dist/
build/
.next/
__pycache__/
*.pyc
