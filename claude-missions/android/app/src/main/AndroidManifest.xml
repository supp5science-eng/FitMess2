<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Slikaj obrok / Slikaj deklaraciju / Prizma. The web code is unchanged:
         `getUserMedia` works in the Android WebView, but only once the app
         itself holds the OS permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Prizma and Gric let the user SAY what they ate instead of typing it.
         Easy to miss, and its absence kills those flows outright. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Podsetnici. Since Android 13 showing a notification is a runtime
         permission, and `@capacitor/push-notifications` does NOT declare it —
         its own manifest only registers the Firebase messaging service. The
         plugin asks for it at runtime, but Android silently refuses to show a
         dialog for a permission the app never declared: `requestPermissions()`
         returns "denied" immediately, and the user is told they blocked
         notifications they were never offered. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declared optional on purpose: a tablet or a phone with no camera can
         still use every other part of FitMess (manual entry, barcode-free
         search, the plan). Leaving these out would let Play hide the app from
         those devices entirely. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
